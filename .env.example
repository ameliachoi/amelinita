# Kit (https://developers.kit.com)
# API Key: Kit dashboard -> Settings -> Developer -> API Keys (usa la "API Key" pública, no el "API Secret")
# Form ID: Kit dashboard -> Grow -> Landing Pages & Forms -> abre el formulario -> el ID está en la URL
KIT_API_KEY=
KIT_FORM_ID=

# Google AdSense (https://adsense.google.com)
# Publisher ID desde AdSense -> Cuenta -> Información de la cuenta (empieza con "ca-pub-")
PUBLIC_ADSENSE_CLIENT_ID=
