---
import { useTranslations, type Lang } from "../i18n/translations";
import { socialLinks, platformLabels, platformIconPath } from "../data/content";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const prefix = lang === "ko" ? "/ko" : "";
const year = new Date().getFullYear();

const navLinks = [
  { href: `${prefix}/sobre-mi/`, label: t("nav.sobreMi") },
  { href: `${prefix}/recursos-pdf/`, label: t("nav.pdf") },
  { href: `${prefix}/suelta-la-lengua/`, label: t("nav.reto") },
  // Blog oculto por ahora.
  // { href: `${prefix}/blog/`, label: t("nav.blog") },
];
---

<footer class="bg-brand-900 text-brand-100">
  <div class="mx-auto max-w-6xl px-4 sm:px-6 py-12">
    <div class="grid gap-10 sm:grid-cols-3">
      <div>
        <p class="font-heading text-lg font-700 text-white">amelinita</p>
        <p class="mt-3 text-sm text-brand-200 max-w-xs">
          {t("footer.tagline")}
        </p>
      </div>

      <div>
        <p class="text-sm font-600 text-white mb-3">{t("footer.explore")}</p>
        <ul class="space-y-2">
          {navLinks.map((link) => (
            <li>
              <a href={link.href} class="text-sm text-brand-200 hover:text-white transition-colors">
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <div>
        <p class="text-sm font-600 text-white mb-3">{t("footer.follow")}</p>
        <ul class="space-y-2">
          {socialLinks.map((social) => (
            <li>
              <a
                href={social.href}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-2 text-sm text-brand-200 hover:text-white transition-colors"
              >
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                  <path d={platformIconPath[social.platform]} />
                </svg>
                {platformLabels[social.platform]} {social.handle}
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>

    <div class="mt-10 flex flex-wrap items-center justify-between gap-3 border-t border-brand-800 pt-6 text-xs text-brand-300">
      <p>&copy; {year} amelinita. {t("footer.rights")}</p>
      <a href={`${prefix}/politica-de-privacidad/`} class="hover:text-white transition-colors">
        {t("footer.privacy")}
      </a>
    </div>
  </div>
</footer>
