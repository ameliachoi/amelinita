---
import type { Platform } from "../data/content";
import { platformBadgeClass, platformIconPath } from "../data/content";

interface Props {
  platform: Platform;
  handle: string;
  href: string;
}

const { platform, handle, href } = Astro.props;
---

<a
  href={href}
  target="_blank"
  rel="noopener noreferrer"
  class="flex flex-col items-center gap-3 rounded-2xl bg-white p-6 text-center shadow-sm ring-1 ring-neutral-100 transition-shadow hover:shadow-md"
>
  <span class:list={["inline-flex h-14 w-14 items-center justify-center rounded-full", platformBadgeClass[platform]]}>
    <svg xmlns="http://www.w3.org/2000/svg" width="26" height="26" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
      <path d={platformIconPath[platform]} />
    </svg>
  </span>
  <span class="font-heading text-sm font-700 text-neutral-900">{handle}</span>
</a>
