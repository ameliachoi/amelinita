---
import { formatPostDate, readingMinutes, type BlogPost } from "../data/blog";
import type { Lang } from "../i18n/translations";

interface Props {
  post: BlogPost;
  lang?: Lang;
}

const { post, lang = "es" } = Astro.props;
const minutesLabel = lang === "ko" ? "분 분량" : "min de lectura";
---

<a
  href={`/blog/${post.id}/`}
  class="group flex h-full flex-col rounded-2xl bg-white p-6 shadow-sm ring-1 ring-neutral-100 transition-shadow hover:shadow-md"
>
  <span class="self-start rounded-full bg-accent-100 px-3 py-1 text-xs font-700 text-accent-700">
    {post.data.tag}
  </span>
  <h2 class="font-heading mt-4 text-xl font-700 leading-snug text-neutral-900 group-hover:text-brand-700 transition-colors">
    {post.data.title}
  </h2>
  <p class="mt-3 flex-1 text-sm text-neutral-600 leading-relaxed">{post.data.description}</p>
  <p class="mt-5 text-xs text-neutral-400">
    <time datetime={post.data.pubDate.toISOString()}>{formatPostDate(post.data.pubDate, lang)}</time>
    · {readingMinutes(post.body)} {minutesLabel}
  </p>
</a>
