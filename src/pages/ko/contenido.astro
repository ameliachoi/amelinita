---
import BaseLayout from "../../layouts/BaseLayout.astro";
import AdSlot from "../../components/AdSlot.astro";
import ContentCard from "../../components/ContentCard.astro";
import { socialLinks } from "../../data/content";

const description =
  "amelinita의 TikTok, YouTube, Instagram, Spotify를 팔로우하세요 — 스페인어권을 위한 무료 한국어 콘텐츠.";
---

<BaseLayout
  title="소셜 미디어 팔로우하기"
  description={description}
  path="/ko/contenido/"
  lang="ko"
>
  <section class="bg-neutral-50 py-16 sm:py-20">
    <div class="mx-auto max-w-3xl px-4 sm:px-6 text-center">
      <span class="inline-block rounded-full bg-accent-100 px-4 py-1 text-xs font-700 uppercase tracking-wide text-accent-700">
        TikTok · YouTube · Instagram · Spotify
      </span>
      <h1 class="font-heading mt-4 text-3xl sm:text-4xl font-800 text-neutral-900">
        어디서든 팔로우하세요 🎧
      </h1>
      <p class="mt-4 text-neutral-600">
        매일 조금씩 한국어를 연습할 수 있는 모든 콘텐츠예요.
      </p>
    </div>
  </section>

  <div class="mx-auto max-w-6xl px-4 sm:px-6">
    <AdSlot position="post-intro" sizeLabel="728x90 / responsive" lang="ko" />

    <div class="mx-auto grid max-w-2xl grid-cols-2 gap-6 py-8 sm:grid-cols-4">
      {socialLinks.map((social) => (
        <ContentCard platform={social.platform} handle={social.handle} href={social.href} />
      ))}
    </div>

    <AdSlot position="pre-footer" sizeLabel="728x90 / responsive" lang="ko" />
  </div>
</BaseLayout>
