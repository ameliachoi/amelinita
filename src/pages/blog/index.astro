---
import BaseLayout from "../../layouts/BaseLayout.astro";
import AdSlot from "../../components/AdSlot.astro";
import BlogFeed from "../../components/BlogFeed.astro";
import SocialFollow from "../../components/SocialFollow.astro";
import { getPublishedPosts } from "../../data/blog";

const posts = await getPublishedPosts();

const description =
  "El blog de amelinita: cultura coreana, coreano para hispanohablantes y mi experiencia como coreana aprendiendo español.";
---

<BaseLayout title="Blog" description={description} path="/blog/">
  <section class="border-b border-neutral-100 py-8">
    <div class="mx-auto max-w-2xl px-4 sm:px-6">
      <h1 class="font-heading text-2xl sm:text-3xl font-800 text-neutral-900">
        Coreanita está pensando... ✍️
      </h1>
      <p class="mt-2 text-sm text-neutral-600">
        Cultura coreana, coreano para hispanohablantes y lo que voy aprendiendo en el camino.
      </p>
    </div>
  </section>

  <div class="mx-auto max-w-6xl px-4 sm:px-6">
    <div class="mx-auto max-w-2xl py-12">
      <BlogFeed posts={posts} />
    </div>

    <div class="py-8">
      <SocialFollow
        title="Sígueme en redes 🎧"
        description="Contenido corto para practicar coreano un poco cada día."
      />
    </div>

    <AdSlot position="pre-footer" sizeLabel="728x90 / responsive" />
  </div>
</BaseLayout>
