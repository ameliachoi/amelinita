---
import BaseLayout from "../../layouts/BaseLayout.astro";
import AdSlot from "../../components/AdSlot.astro";
import BlogPostCard from "../../components/BlogPostCard.astro";
import SocialFollow from "../../components/SocialFollow.astro";
import { getPublishedPosts } from "../../data/blog";

const posts = await getPublishedPosts();

const description =
  "El blog de amelinita: cultura coreana, coreano para hispanohablantes y mi experiencia como coreana aprendiendo español.";
---

<BaseLayout title="Blog" description={description} path="/blog/">
  <section class="bg-neutral-50 py-16 sm:py-20">
    <div class="mx-auto max-w-3xl px-4 sm:px-6 text-center">
      <span class="inline-block rounded-full bg-accent-100 px-4 py-1 text-xs font-700 uppercase tracking-wide text-accent-700">
        Blog
      </span>
      <h1 class="font-heading mt-4 text-3xl sm:text-4xl font-800 text-neutral-900">
        Coreanita está pensando... ✍️
      </h1>
      <p class="mt-4 text-neutral-600">
        Cultura coreana, coreano para hispanohablantes y lo que voy aprendiendo en el camino.
      </p>
    </div>
  </section>

  <div class="mx-auto max-w-6xl px-4 sm:px-6">
    <AdSlot position="post-intro" sizeLabel="728x90 / responsive" />

    <div class="grid gap-6 py-8 md:grid-cols-2 lg:grid-cols-3">
      {posts.map((post) => <BlogPostCard post={post} />)}
    </div>

    <div class="py-8">
      <SocialFollow
        title="Sígueme en redes 🎧"
        description="Contenido corto para practicar coreano un poco cada día."
      />
    </div>

    <AdSlot position="pre-footer" sizeLabel="728x90 / responsive" />
  </div>
</BaseLayout>
